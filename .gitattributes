# v3.0.0 新增：此前仓库没有任何换行符策略，跨机协作时
# .bat / .ps1 的 CRLF 与 .cs / .xaml 的 LF 容易产生整文件级 diff 噪声。

* text=auto eol=crlf

*.cs      text eol=crlf
*.xaml    text eol=crlf
*.csproj  text eol=crlf
*.props   text eol=crlf
*.sln     text eol=crlf
*.ps1     text eol=crlf
*.bat     text eol=crlf

*.md      text eol=lf
*.gitignore text eol=lf

# 二进制资源不做换行符转换
*.dll     binary
*.exe     binary
*.pdb     binary
*.ico     binary
*.png     binary
*.snk     binary
