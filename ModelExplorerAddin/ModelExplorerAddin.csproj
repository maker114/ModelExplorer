<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>ModelExplorerAddin</RootNamespace>
    <AssemblyName>ModelExplorerAddin</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- COM 注册需要强名称；密钥文件已提升到仓库根，供 Core 与插件共用。 -->
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\ModelExplorer.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!--
    v3.0.0 变更：
     - 由旧式 csproj + csc.exe 脚本改为标准 SDK 项目，纳入 ModelExplorer.sln。
     - 删除 AddinSettings：配置改用共享的 ConfigService / AppConfig。
     - STL 导出与 Bambu 启动改用 ModelExplorer.Core，不再各自维护一份副本。
     - Interop 引用（含原先缺失的 swpublished）由 Directory.Build.props 统一提供，
       不再硬编码 D:\SW2022\SOLIDWORKS\。
  -->
  <ItemGroup>
    <ProjectReference Include="..\ModelExplorer.Core\ModelExplorer.Core.csproj" />
  </ItemGroup>

</Project>
