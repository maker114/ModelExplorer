<Window x:Class="ModelExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:ModelExplorer"
        Title="Model Explorer"
        Width="1200"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
  <Window.Resources>
    <local:KindBrushConverter x:Key="KindBrushConverter" />
    <SolidColorBrush x:Key="BgBrush" Color="#101010" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#161616" />
    <SolidColorBrush x:Key="PanelBrush" Color="#1C1C1C" />
    <SolidColorBrush x:Key="PanelActiveBrush" Color="#2A2A2A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MutedBrush" Color="#B0B0B0" />
    <SolidColorBrush x:Key="AccentBrush" Color="#F5C518" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFD75E" />
    <SolidColorBrush x:Key="PartBrush" Color="#E0D3C6" />
    <SolidColorBrush x:Key="AssemblyBrush" Color="#BBCD9E" />
    <SolidColorBrush x:Key="StlBrush" Color="#9A8DBC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FF6B6B" />
    <SolidColorBrush x:Key="CodeBrush" Color="#0A0A0A" />

    <sys:Double x:Key="BadgeFontSize">9</sys:Double>
    <sys:Double x:Key="NameFontSize">11</sys:Double>
    <sys:Double x:Key="MetaFontSize">8</sys:Double>

    <Style x:Key="SidebarSectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="SidebarBoxStyle" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <Style x:Key="ButtonMotionStyle" TargetType="Button">
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                 To="1.035"
                                 Duration="0:0:0.09">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                 To="1.035"
                                 Duration="0:0:0.09">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                 To="1"
                                 Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                 To="1"
                                 Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
        <Trigger Property="IsPressed" Value="True">
          <Trigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                 To="0.92"
                                 Duration="0:0:0.07">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                 To="0.92"
                                 Duration="0:0:0.07">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 To="0.82"
                                 Duration="0:0:0.07" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.EnterActions>
          <Trigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                 To="1"
                                 Duration="0:0:0.08">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                 To="1"
                                 Duration="0:0:0.08">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                 To="1"
                                 Duration="0:0:0.08" />
              </Storyboard>
            </BeginStoryboard>
          </Trigger.ExitActions>
        </Trigger>
        <EventTrigger RoutedEvent="Button.Click">
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.93" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.93" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.16" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.78" />
                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1">
                  <EasingDoubleKeyFrame.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </EasingDoubleKeyFrame.EasingFunction>
                </EasingDoubleKeyFrame>
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ButtonMotionStyle}">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="#151515" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ButtonMotionStyle}">
      <Setter Property="Background" Value="{DynamicResource PanelActiveBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="14,9" />
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A4253" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="bd" Property="Opacity" Value="0.45" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ChromeButtonStyle" TargetType="Button"
           BasedOn="{StaticResource ButtonMotionStyle}">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Margin" Value="2,0,0,0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="5"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#3A4253" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type CheckBox}">
            <Grid Width="48" Height="28">
              <Border x:Name="track"
                      Width="46"
                      Height="26"
                      CornerRadius="13"
                      Background="#3A4253" />
              <Ellipse x:Name="thumb"
                       Width="20"
                       Height="20"
                       Fill="#FFFFFF"
                       HorizontalAlignment="Left"
                       Margin="3,0,0,0">
                <Ellipse.RenderTransform>
                  <TranslateTransform x:Name="thumbMove" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <ContentPresenter Visibility="Collapsed" />
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumbMove"
                                       Storyboard.TargetProperty="(TranslateTransform.X)"
                                       To="20"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="thumbMove"
                                       Storyboard.TargetProperty="(TranslateTransform.X)"
                                       To="0"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseInOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ExpanderArrowStyle" TargetType="Path">
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <RotateTransform Angle="-90" />
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType={x:Type Expander}}}"
                     Value="True">
          <DataTrigger.EnterActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                 To="0"
                                 Duration="0:0:0.16">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <BeginStoryboard>
              <Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(RotateTransform.Angle)"
                                 To="-90"
                                 Duration="0:0:0.16">
                  <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut" />
                  </DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.ExitActions>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,4" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Expander}">
            <StackPanel>
              <ToggleButton x:Name="HeaderSite"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            Content="{TemplateBinding Header}"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            HorizontalAlignment="Stretch">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Stretch" />
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="ExpandSite"
                                Content="{TemplateBinding Content}"
                                Visibility="Collapsed" />
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModelListBoxItemStyle" TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,4" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform">
        <Setter.Value>
          <ScaleTransform ScaleX="1" ScaleY="1" />
        </Setter.Value>
      </Setter>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="bd"
                    Background="Transparent"
                    CornerRadius="6"
                    Padding="4">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelActiveBrush}" />
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource PanelActiveBrush}" />
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter TargetName="bd" Property="BorderThickness" Value="1" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                       From="0.985"
                                       To="1"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                       From="0.985"
                                       To="1"
                                       Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                          <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ModelListStyle" TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <DataTemplate x:Key="ModelTemplate">
      <Border Background="{DynamicResource PanelBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1"
              CornerRadius="6"
              Padding="10">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Background="{DynamicResource PanelActiveBrush}"
                    CornerRadius="4"
                    Padding="8,4">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="MinHeight" Value="0" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding FolderVisible}" Value="True">
                      <Setter Property="VerticalAlignment" Value="Stretch" />
                      <Setter Property="MinHeight" Value="34" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <TextBlock Text="{Binding TypeLabel}"
                         Foreground="{Binding Kind, Converter={StaticResource KindBrushConverter}}"
                         FontSize="{DynamicResource BadgeFontSize}"
                         FontWeight="Bold"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding Name}"
                         Foreground="{DynamicResource TextBrush}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="{DynamicResource NameFontSize}"
                         FontWeight="Bold"
                         TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding FolderText}"
                         Foreground="{DynamicResource MutedBrush}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="{DynamicResource MetaFontSize}"
                         Margin="0,3,0,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding FolderVisible}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <TextBlock Text="{Binding UnorganizedText}"
                         Foreground="#FFB340"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="{DynamicResource MetaFontSize}"
                         FontWeight="Bold" />
              <TextBlock Text="{Binding OrphanText}"
                         Foreground="{DynamicResource ErrorBrush}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="{DynamicResource MetaFontSize}"
                         FontWeight="Bold"
                         Margin="8,0,0,0" />
            </StackPanel>
          </Grid>
          <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       Text="{Binding SizeText}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource MetaFontSize}"
                       HorizontalAlignment="Left" />
            <TextBlock Grid.Column="1"
                       Text="{Binding ModifiedText}"
                       Foreground="{DynamicResource MutedBrush}"
                       FontSize="{DynamicResource MetaFontSize}"
                       HorizontalAlignment="Right" />
          </Grid>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border SnapsToDevicePixels="True"
          UseLayoutRounding="True">
    <!-- ShellRoot 的第一个子元素必须是窗口不透明底色：毛玻璃背景层会插在它之上
         （见 Glass.Apply），最后那层描边留在最上面，窗口外框才不会被糊掉。 -->
    <Grid x:Name="ShellRoot"
          ClipToBounds="True">
      <Border Background="{DynamicResource BgBrush}"
              CornerRadius="14"
              ClipToBounds="True" />
      <Rectangle Stroke="{DynamicResource BorderBrush}"
                 StrokeThickness="1"
                 RadiusX="14"
                 RadiusY="14"
                 SnapsToDevicePixels="True"
                 IsHitTestVisible="False" />
      <Grid Margin="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="76" />
        <RowDefinition Height="*" />
        <RowDefinition Height="28" />
      </Grid.RowDefinitions>

      <Border Grid.Row="0"
              Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="Header_MouseLeftButtonDown">
        <Grid Margin="18,10">
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Model Explorer"
                         Foreground="{DynamicResource TextBrush}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="19"
                         FontWeight="Bold"
                         VerticalAlignment="Bottom" />
              <!-- 版本号由 MainWindow 从程序集信息读取（源于 AssemblyInfo.cs），
                   不再在这里手写一份，避免升版时两处不同步 -->
              <TextBlock x:Name="VersionText"
                         Foreground="{DynamicResource AccentBrush}"
                         FontFamily="Microsoft YaHei UI"
                         FontSize="13"
                         FontWeight="Bold"
                         Margin="12,0,0,0"
                         VerticalAlignment="Bottom" />
            </StackPanel>
            <TextBlock Text="SolidWorks → STL → Bambu Studio → 3MF"
                       Foreground="{DynamicResource MutedBrush}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="11"
                       Margin="0,4,0,0" />
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center">
            <Button Content="设置"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="OpenSettings_Click" />
            <Button Content="选择工程目录"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,10,0"
                    Click="ChooseFolder_Click" />
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Click="Minimize_Click">
              <Path Data="M 0,0 L 16,0"
                    Stroke="{DynamicResource MutedBrush}"
                    StrokeThickness="2.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Width="16"
                    Height="2"
                    Stretch="Fill" />
            </Button>
            <Button Style="{StaticResource ChromeButtonStyle}"
                    Click="Close_Click">
              <Path Data="M 0,0 L 14,14 M 14,0 L 0,14"
                    Stroke="{DynamicResource MutedBrush}"
                    StrokeThickness="2.4"
                    StrokeStartLineCap="Round"
                    StrokeEndLineCap="Round"
                    Width="14"
                    Height="14"
                    Stretch="Fill" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel Margin="16,18">
              <TextBlock Text="工程目录"
                         Style="{StaticResource SidebarSectionTitleStyle}" />
              <Border Style="{StaticResource SidebarBoxStyle}">
                <StackPanel>
                  <TextBlock x:Name="DirectoryText"
                             Text="尚未选择"
                             Foreground="{DynamicResource TextBrush}"
                             FontFamily="Consolas"
                             FontSize="11"
                             TextWrapping="Wrap"
                             Cursor="Hand"
                             MouseLeftButtonDown="OpenProjectFolder_Click" />
                  <Button x:Name="ScanButton"
                          Content="重新扫描"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Margin="0,10,0,0"
                          Click="Scan_Click" />
                </StackPanel>
              </Border>

              <TextBlock Text="统计"
                         Style="{StaticResource SidebarSectionTitleStyle}"
                         Margin="0,16,0,8" />
              <Border Style="{StaticResource SidebarBoxStyle}">
                <StackPanel Cursor="Hand" MouseLeftButtonDown="Stats_MouseLeftButtonDown">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition />
                      <RowDefinition />
                      <RowDefinition />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="零件"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,3" />
                    <TextBlock x:Name="PartCountText" Grid.Row="0" Grid.Column="1" Text="0"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12" FontWeight="Bold" Margin="0,3" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="装配体"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,3" />
                    <TextBlock x:Name="AsmCountText" Grid.Row="1" Grid.Column="1" Text="0"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12" FontWeight="Bold" Margin="0,3" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="文件总数"
                               Foreground="{DynamicResource MutedBrush}"
                               FontSize="12" Margin="0,3" />
                    <TextBlock x:Name="TotalCountText" Grid.Row="2" Grid.Column="1" Text="0"
                               Foreground="{DynamicResource TextBrush}"
                               FontSize="12" FontWeight="Bold" Margin="0,3" />
                  </Grid>
                  <TextBlock Text="点击查看详细统计..."
                             Foreground="{DynamicResource AccentBrush}"
                             FontFamily="Microsoft YaHei UI"
                             FontSize="11"
                             FontWeight="Bold"
                             Margin="0,8,0,0" />
                </StackPanel>
              </Border>

              <TextBlock Text="STL/3MF文件整理"
                         Style="{StaticResource SidebarSectionTitleStyle}"
                         Margin="0,16,0,8" />
              <Border Style="{StaticResource SidebarBoxStyle}">
                <StackPanel>
                  <!-- 「按文件夹整理」开关已移入设置窗口（V3.0.7）；
                       按钮文本按当前模式回显，见 ApplyConfigToUi -->
                  <Button x:Name="OrganizeFilesButton"
                          Content="整理 STL / 3MF 文件"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Margin="0,0,0,0"
                          Click="OrganizeFiles_Click" />
                  <Button x:Name="UndoOrganizeButton"
                          Content="撤销整理"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Margin="0,8,0,0"
                          IsEnabled="False"
                          Click="UndoOrganize_Click" />
                </StackPanel>
              </Border>

              <TextBlock Text="工程名整理"
                         Style="{StaticResource SidebarSectionTitleStyle}"
                         Margin="0,16,0,8" />
              <Border Style="{StaticResource SidebarBoxStyle}">
                <StackPanel>
                  <Button x:Name="CheckProjectNamesButton"
                          Content="检查 / 补充工程名"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Margin="0,7,0,0"
                          Click="CheckProjectNames_Click" />
                  <Button x:Name="UndoProjectNameButton"
                          Content="撤销工程名修改"
                          Style="{StaticResource SecondaryButtonStyle}"
                          Margin="0,8,0,0"
                          IsEnabled="False"
                          Click="UndoProjectName_Click" />
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Margin="14">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Border Background="{DynamicResource PanelBrush}"
                  BorderBrush="{DynamicResource BorderBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8,6">
            <TextBox x:Name="SearchBox"
                     Text="搜索零件或装配体"
                     Background="Transparent"
                     Foreground="{DynamicResource MutedBrush}"
                     BorderThickness="0"
                     Padding="0"
                     CaretBrush="{DynamicResource TextBrush}"
                     FontSize="12"
                     VerticalContentAlignment="Center"
                     GotKeyboardFocus="SearchBox_GotKeyboardFocus"
                     LostKeyboardFocus="SearchBox_LostKeyboardFocus"
                     TextChanged="SearchBox_TextChanged" />
          </Border>

          <ScrollViewer Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        CanContentScroll="False"
                        Margin="0,10,0,0"
                        PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel>
              <Expander IsExpanded="True">
                <Expander.Header>
                  <Grid Margin="0,0,0,6" PreviewMouseLeftButtonDown="ExpanderHeader_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26"
                            Height="24"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                      <Path Style="{StaticResource ExpanderArrowStyle}" Data="M 0,4 L 8,12 L 16,4"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="2.2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Width="16"
                            Height="12"
                            Stretch="Fill" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="零件"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <TextBlock x:Name="PartHeaderText"
                               Grid.Column="2"
                               Text="[0]"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <Border Grid.Column="3"
                            Height="2"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                  </Grid>
                </Expander.Header>
                <ListBox x:Name="PartList"
                         Style="{StaticResource ModelListStyle}"
                         ItemTemplate="{StaticResource ModelTemplate}"
                         ItemContainerStyle="{StaticResource ModelListBoxItemStyle}"
                         SelectionChanged="PartList_SelectionChanged" />
              </Expander>

              <Expander IsExpanded="True">
                <Expander.Header>
                  <Grid Margin="0,0,0,6" PreviewMouseLeftButtonDown="ExpanderHeader_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26"
                            Height="24"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                      <Path Style="{StaticResource ExpanderArrowStyle}" Data="M 0,4 L 8,12 L 16,4"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="2.2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Width="16"
                            Height="12"
                            Stretch="Fill" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="装配体"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <TextBlock x:Name="AsmHeaderText"
                               Grid.Column="2"
                               Text="[0]"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <Border Grid.Column="3"
                            Height="2"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                  </Grid>
                </Expander.Header>
                <ListBox x:Name="AsmList"
                         Style="{StaticResource ModelListStyle}"
                         ItemTemplate="{StaticResource ModelTemplate}"
                         ItemContainerStyle="{StaticResource ModelListBoxItemStyle}"
                         SelectionChanged="AsmList_SelectionChanged" />
              </Expander>

              <Expander IsExpanded="True">
                <Expander.Header>
                  <Grid Margin="0,0,0,6" PreviewMouseLeftButtonDown="ExpanderHeader_PreviewMouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="26"
                            Height="24"
                            Background="Transparent"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                      <Path Style="{StaticResource ExpanderArrowStyle}" Data="M 0,4 L 8,12 L 16,4"
                            Stroke="{DynamicResource AccentBrush}"
                            StrokeThickness="2.2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Width="16"
                            Height="12"
                            Stretch="Fill" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="STL 文件"
                               Foreground="{DynamicResource AccentBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="14"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <TextBlock x:Name="StlHeaderText"
                               Grid.Column="2"
                               Text="[0]"
                               Foreground="{DynamicResource TextBrush}"
                               FontFamily="Microsoft YaHei UI"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                    <Border Grid.Column="3"
                            Height="2"
                            Background="{DynamicResource BorderBrush}"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0" />
                  </Grid>
                </Expander.Header>
                <ListBox x:Name="StlList"
                         Style="{StaticResource ModelListStyle}"
                         ItemTemplate="{StaticResource ModelTemplate}"
                         ItemContainerStyle="{StaticResource ModelListBoxItemStyle}"
                         SelectionChanged="StlList_SelectionChanged" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border Grid.Column="2"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1,0,0,0">
          <Grid Margin="16,18,16,16">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Text="选中模型"
                         Style="{StaticResource SectionTitleStyle}"
                         VerticalAlignment="Center" />
              <Button x:Name="RenameButton"
                      Grid.Column="1"
                      Content="重命名"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Padding="10,5"
                      FontSize="10"
                      Margin="10,0,0,0"
                      IsEnabled="False"
                      Click="Rename_Click" />
            </Grid>
            <TextBlock x:Name="DetailName"
                       Grid.Row="1"
                       Text="未选择"
                       Foreground="{DynamicResource TextBrush}"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="14"
                       FontWeight="Bold"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0" />
            <TextBlock x:Name="DetailMeta"
                       Grid.Row="2"
                       Foreground="{DynamicResource MutedBrush}"
                       FontFamily="Consolas"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Margin="0,10,0,0" />
            <Button x:Name="ExportButton"
                    Grid.Row="3"
                    Content="导出 STL 并打开 Bambu Studio"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,18,0,8"
                    IsEnabled="False"
                    Click="Export_Click" />
            <TextBlock Grid.Row="5"
                       Text="运行日志"
                       Style="{StaticResource SectionTitleStyle}"
                       Margin="0,18,0,6" />
            <TextBox x:Name="LogBox"
                     Grid.Row="6"
                     Background="{DynamicResource CodeBrush}"
                     Foreground="#C9D1E0"
                     FontFamily="Consolas"
                     FontSize="10"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled"
                     BorderThickness="0"
                     Padding="8" />
          </Grid>
        </Border>
      </Grid>

      <!-- 状态栏原先写死 #0D1017，改成跟随主题的侧栏色，才能与其它玻璃面板一起半透明 -->
      <Border Grid.Row="2" Background="{DynamicResource SidebarBrush}">
        <TextBlock x:Name="StatusText"
                   Text="就绪"
                   Foreground="{DynamicResource MutedBrush}"
                   FontFamily="Microsoft YaHei UI"
                   FontSize="11"
                   Margin="14,0,0,0"
                   VerticalAlignment="Center" />
      </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
