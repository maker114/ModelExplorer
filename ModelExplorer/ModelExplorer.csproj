<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ModelExplorer</RootNamespace>
    <AssemblyName>ModelExplorer</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <!--
    业务逻辑（扫描、命名规则、整理、配置、STL 导出、Bambu 启动）已全部下沉到
    ModelExplorer.Core，与 CLI、SolidWorks 插件共享同一份实现。
    本工程只保留界面与主题。
    TargetFramework / PlatformTarget / LangVersion 等由 Directory.Build.props 统一提供。
  -->
  <ItemGroup>
    <ProjectReference Include="..\ModelExplorer.Core\ModelExplorer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="ModelExplorer.Resources.app.ico" />
  </ItemGroup>

</Project>
